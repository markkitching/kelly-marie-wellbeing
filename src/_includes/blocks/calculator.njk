{#
  "What is poor mental health costing your business?"

  Shown on the Training & Coaching page and on its own page at /cost-calculator/, the
  address meant for sharing. Both read the same content (src/content/calculator.json),
  so editing the wording in the CMS changes it in both places.

  What a visitor sees, in order:
    1. one question (headcount) and an instant answer — no sign-up, ever, for this;
    2. "Make this estimate more accurate" (optional, inside the calculator) — their own
       figures, compared side by side;
    3. "How we calculated this" — every assumption stated, and editable;
    4. a printable summary, behind a short form (Formspree,
       the same endpoint as the contact form).

  The arithmetic lives in src/js/cost-calculator.js, tested by scripts/test-calculator.js.

  Expects: bg (section background), calcHeadingTag ("h1" on its own page, else "h2").
#}
{%- set calc = content.calculator or {} -%}
{%- set categories = [
  { key: "presenteeism", label: "Working while unwell", note: "Lower focus and productivity when people come in but are struggling" },
  { key: "turnover", label: "Staff leaving", note: "Recruiting, onboarding and lost experience when people leave" },
  { key: "absence", label: "Sickness absence", note: "Days lost to stress, anxiety, depression and burnout" }
] -%}
{#- The figures in the editor's "Cost calculator" entry are the ones used. A figure left
    blank falls back to the default in src/js/cost-calculator.js (via calcDefaults)
    rather than quietly counting as zero. -#}
{%- set def = calcDefaults -%}
{%- set calcConfig = {
  perEmployee: {
    presenteeism: calc.presenteeismCost | float(def.perEmployee.presenteeism),
    turnover: calc.turnoverCost | float(def.perEmployee.turnover),
    absence: calc.absenceCost | float(def.perEmployee.absence)
  },
  assumptions: {
    daysPerAbsence: calc.daysPerAbsence | float(def.assumptions.daysPerAbsence),
    replacementPct: calc.replacementPct | float(def.assumptions.replacementPct),
    productivityLossPct: calc.productivityLossPct | float(def.assumptions.productivityLossPct),
    onCostPct: calc.onCostPct | float(def.assumptions.onCostPct),
    workingDays: def.assumptions.workingDays
  },
  categories: categories,
  calculatorUrl: links.site + links.calculator,
  contactEmail: content.contact.email,
  orgName: content.header.logoLine1 + " " + content.header.logoLine2,
  heading: calc.heading or "What Is Poor Mental Health Costing Your Business?",
  sourceNote: calc.sourceNote,
  roiText: calc.ctaText
} -%}
{%- set perEmployee = calcConfig.perEmployee.presenteeism + calcConfig.perEmployee.turnover + calcConfig.perEmployee.absence -%}
{%- set tag = calcHeadingTag or "h2" -%}
{#- One level below the heading, so the outline never skips a level. -#}
{%- set subTag = "h2" if tag == "h1" else "h3" -%}
{%- set inputClass = "w-full border border-gray-300 rounded px-4 py-3 text-gray-800 bg-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-sage/40 focus:border-sage transition-colors aria-[invalid=true]:border-red-600" -%}
{%- set labelClass = "block text-sm font-semibold text-forest mb-1.5" -%}
{%- set hintClass = "text-xs text-gray-600 mb-2" -%}
{%- set errorClass = "hidden text-xs text-red-700 mt-1.5" -%}

{#- One labelled numeric field. Text rather than type=number so "£35,000" is accepted
    and anything else gets a clear message, rather than the browser silently emptying it. -#}
{%- macro numberField(id, name, label, hint, placeholder, mode, prefix, suffix, value) -%}
<div>
  <label for="{{ id }}" class="{{ labelClass }}">{{ label }}</label>
  {% if hint %}<p id="{{ id }}-hint" class="{{ hintClass }}">{{ hint }}</p>{% endif %}
  <div class="relative">
    {% if prefix %}<span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-600" aria-hidden="true">{{ prefix }}</span>{% endif %}
    <input id="{{ id }}" name="{{ name }}" type="text" inputmode="{{ mode or 'numeric' }}" autocomplete="off"
      {% if value is defined %}value="{{ value }}"{% endif %}
      {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
      aria-describedby="{% if hint %}{{ id }}-hint {% endif %}{{ id }}-error"
      class="{{ inputClass }}{% if prefix %} pl-8{% endif %}{% if suffix %} pr-16{% endif %}" data-calc-field="{{ name }}" />
    {% if suffix %}<span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm text-gray-600" aria-hidden="true">{{ suffix }}</span>{% endif %}
  </div>
  <p id="{{ id }}-error" class="{{ errorClass }}" role="alert"></p>
</div>
{%- endmacro -%}

<!-- ══════════════════════════ COST CALCULATOR ══════════════════════════ -->
<section id="calculator" class="{{ bg }} py-20" data-calculator>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center">
      {% if calc.eyebrow %}
      <div class="flex items-center justify-center gap-2 mb-6">
        <span class="w-px h-5 bg-sage"></span>
        <span class="text-sage text-sm font-semibold uppercase tracking-widest">{{ calc.eyebrow }}</span>
        <span class="w-px h-5 bg-sage"></span>
      </div>
      {% endif %}
      <{{ tag }} class="font-serif text-forest {% if tag == 'h1' %}text-4xl lg:text-5xl{% else %}text-3xl{% endif %} leading-tight max-w-3xl mx-auto">
        {{ calcConfig.heading }}
      </{{ tag }}>
      <div class="divider mt-4 mb-8 mx-auto"></div>
      {% if calc.intro %}
      <p class="text-gray-600 text-lg leading-relaxed max-w-2xl mx-auto mb-12">{{ calc.intro | lines }}</p>
      {% endif %}
    </div>

    <!-- ── 1. The one question, and the answer ── -->
    <div class="max-w-4xl mx-auto bg-white rounded-lg border border-gray-100 border-t-4 border-t-sage shadow-sm grid md:grid-cols-5">

      <div class="md:col-span-2 p-6 sm:p-8 bg-stone/60 md:rounded-bl-lg">
        <label for="calc-staff" class="block font-medium text-forest mb-3">
          {{ calc.staffLabel or "How many people does your organisation employ?" }}
        </label>
        <div class="flex items-stretch rounded border border-gray-300 bg-white focus-within:border-sage focus-within:ring-2 focus-within:ring-sage/30">
          <span class="flex items-center pl-4 text-sage" aria-hidden="true"><i data-lucide="users" class="w-5 h-5"></i></span>
          <input id="calc-staff" type="number" inputmode="numeric" min="1" max="1000000" step="1" value="50"
            aria-describedby="calc-staff-error"
            class="w-full px-3 py-3 text-2xl font-semibold text-forest bg-transparent outline-none" data-calc-staff />
        </div>
        <p id="calc-staff-error" class="{{ errorClass }}" role="alert"></p>
        <input type="range" min="1" max="500" step="1" value="50" aria-label="Number of employees"
          class="calc-range w-full mt-5" data-calc-range />
        <div class="flex justify-between text-xs text-gray-600 mt-1" aria-hidden="true">
          <span>1</span><span>500+</span>
        </div>

        <!-- ── 2. Their own figures, optional, inside the calculator ── -->
        <details class="calc-panel mt-6 border-t border-gray-200 pt-4" data-calc-more>
          <summary class="flex items-center justify-between gap-3 cursor-pointer list-none rounded py-1">
            <span>
              <span class="flex items-center gap-2 font-medium text-forest">
                <i data-lucide="sliders-horizontal" class="w-4 h-4 text-sage"></i>
                Make this estimate more accurate
              </span>
              <span class="inline-block mt-1 text-[11px] font-semibold uppercase tracking-wide text-gray-700 bg-white border border-gray-300 rounded px-1.5 py-0.5">Optional</span>
            </span>
            <i data-lucide="plus" class="calc-panel-icon w-4 h-4 text-sage flex-shrink-0"></i>
          </summary>
          <div class="pt-4">
            <p class="text-sm text-gray-600 mb-4">
              Fill in any you know. Blanks use the headcount estimate. Your figures stay in your browser unless you request a summary.
            </p>
            <div class="grid gap-4">
              {{ numberField("calc-salary", "salary", "Average annual salary per employee", "Before tax, in pounds.", "e.g. 32,000", "decimal", "£") }}
              {{ numberField("calc-absent", "absentStaff", "Staff off sick with a mental health reason", "In the last 12 months.", "e.g. 3") }}
              {{ numberField("calc-leavers", "leavers", "Staff who left where mental health was a factor", "In the last 12 months.", "e.g. 2") }}
              {{ numberField("calc-struggling", "strugglingStaff", "Staff still working but struggling with performance", "Your best estimate, right now.", "e.g. 5") }}
            </div>
            <p class="hidden text-sm text-forest mt-4 rounded bg-white border border-gray-200 px-4 py-3" data-calc-more-status></p>
          </div>
        </details>
      </div>

      <div class="md:col-span-3 p-6 sm:p-8" aria-live="polite">
        <p class="text-gray-600 text-sm">{{ calc.resultLabel or "Poor mental health could be costing your organisation around" }}</p>
        <p class="font-serif text-forest text-4xl sm:text-5xl mt-2">
          <span data-calc-total>{{ (perEmployee * 50) | gbp }}</span><span class="text-lg text-gray-600 font-sans"> a year</span>
        </p>
        <p class="text-sm text-gray-600 mt-2">
          That's about <span class="font-medium text-forest" data-calc-per>{{ perEmployee | gbp }}</span> per employee, every year.
        </p>

        <!-- Appears once their own figures change the answer -->
        <div class="hidden mt-4 rounded border border-sage/30 bg-sage/10 px-4 py-3" data-calc-yours-summary>
          <p class="text-sm text-forest">
            Using your figures: <strong class="text-lg" data-calc-yours-total></strong> a year
          </p>
          <p class="text-xs text-gray-700 mt-0.5" data-calc-yours-diff></p>
        </div>

        <ul class="mt-8 space-y-5">
          {% for cat in categories %}
          <li data-calc-row="{{ cat.key }}">
            <div class="flex items-baseline justify-between gap-4">
              <span class="font-medium text-forest">{{ cat.label }}</span>
              <span class="text-right">
                <span class="block font-semibold text-forest tabular-nums" data-calc-part>{{ (calcConfig.perEmployee[cat.key] * 50) | gbp }}</span>
                <span class="hidden text-xs text-gray-700 tabular-nums" data-calc-part-yours></span>
              </span>
            </div>
            <div class="h-2 rounded-full bg-stone mt-2 overflow-hidden">
              <div class="h-full rounded-full bg-sage transition-all" data-calc-bar style="width: {{ (calcConfig.perEmployee[cat.key] / perEmployee * 100) | round(1) }}%"></div>
            </div>
            <p class="text-xs text-gray-600 mt-1.5">{{ cat.note }}</p>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <div class="max-w-4xl mx-auto mt-6 space-y-4">

      <!-- ── 3. The assumptions ── -->
      <details class="calc-panel group bg-white rounded-lg border border-gray-200">
        <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-6 py-5">
          <span class="flex items-center gap-2 font-medium text-forest"><i data-lucide="calculator" class="w-4 h-4 text-sage"></i> How we calculated this</span>
          <i data-lucide="plus" class="calc-panel-icon w-4 h-4 text-sage flex-shrink-0"></i>
        </summary>
        <div class="px-6 pb-6 border-t border-gray-100 pt-5 text-sm text-gray-700 leading-relaxed space-y-4">
          <div>
            <{{ subTag }} class="font-semibold text-forest mb-1">Your workings</{{ subTag }}>
            {#- Focusable so keyboard users can scroll it sideways on narrow screens. -#}
            <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Your workings">
              <table class="w-full text-sm text-left">
                <thead>
                  <tr class="border-b border-gray-200 text-gray-700">
                    <th scope="col" class="py-2 pr-4 font-semibold">Cost</th>
                    <th scope="col" class="py-2 pr-4 font-semibold">How it's worked out</th>
                    <th scope="col" class="py-2 font-semibold text-right">Per year</th>
                  </tr>
                </thead>
                <tbody data-calc-workings></tbody>
              </table>
            </div>
          </div>
          <div>
            <{{ subTag }} class="font-semibold text-forest mb-1">The headcount estimate</{{ subTag }}>
            <p>
              Your number of staff multiplied by an average cost per employee:
              <span class="tabular-nums">{{ calcConfig.perEmployee.presenteeism | gbp }}</span> for working while unwell,
              <span class="tabular-nums">{{ calcConfig.perEmployee.turnover | gbp }}</span> for staff leaving and
              <span class="tabular-nums">{{ calcConfig.perEmployee.absence | gbp }}</span> for sickness absence.
              These come from Deloitte's UK totals divided by roughly 30 million UK employees. That division is our own approximation.
            </p>
          </div>
          <div>
            <{{ subTag }} class="font-semibold text-forest mb-1">Your figures</{{ subTag }}>
            <ul class="list-disc pl-5 space-y-1">
              <li><strong>Sickness absence</strong> = staff off × days lost per absence × daily pay (salary plus on-costs, over {{ calcConfig.assumptions.workingDays }} working days)</li>
              <li><strong>Staff leaving</strong> = leavers × salary × cost of replacing a leaver</li>
              <li><strong>Working while unwell</strong> = staff struggling × salary plus on-costs × productivity lost</li>
            </ul>
          </div>
          <div>
            <{{ subTag }} class="font-semibold text-forest mb-1">Our assumptions</{{ subTag }}>
            <p class="mb-4">
              Days lost per absence is rounded from Health and Safety Executive figures.
              Change any of them to match your organisation and the estimate updates as you type.
            </p>
            <div class="grid sm:grid-cols-2 gap-5">
              {{ numberField("calc-days", "daysPerAbsence", "Working days lost per absence", "HSE's 2024/25 average was 22.9 days per case of work-related stress, depression or anxiety.", "", "decimal", "", "days", calcConfig.assumptions.daysPerAbsence) }}
              {{ numberField("calc-replace", "replacementPct", "Cost of replacing a leaver", "As a share of their salary.", "", "decimal", "", "%", calcConfig.assumptions.replacementPct) }}
              {{ numberField("calc-productivity", "productivityLossPct", "Productivity lost per struggling employee", "", "", "decimal", "", "%", calcConfig.assumptions.productivityLossPct) }}
              {{ numberField("calc-oncost", "onCostPct", "Employer on-costs", "National Insurance and pension, on top of salary.", "", "decimal", "", "%", calcConfig.assumptions.onCostPct) }}
            </div>
            <button type="button" class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-forest underline underline-offset-2 hover:text-sage" data-calc-reset>
              <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Reset to our defaults
            </button>
          </div>
        </div>
      </details>

      <!-- ── 4. Printable summary, behind a short form ── -->
      <div class="bg-white rounded-lg border border-gray-200 border-t-4 border-t-forest px-6 py-6 sm:px-8 sm:py-8" id="calc-summary" tabindex="-1">
        <div data-calc-locked>
          <{{ subTag }} class="font-serif text-forest text-2xl">{{ calc.captureHeading or "Get a printable summary" }}</{{ subTag }}>
          <p class="text-gray-600 mt-2 mb-6">{{ (calc.captureText or "Download a one-page summary of your estimate to share with your manager, leadership team or board.") | lines }}</p>

          <form class="space-y-5" data-calc-form action="{{ content.site.formspreeEndpoint }}" method="POST" novalidate>
            <input type="hidden" name="_subject" value="Cost calculator lead" />
            <input type="hidden" name="source" value="Cost calculator" />
            <input type="hidden" name="estimate" value="" data-calc-form-estimate />
            {#- Formspree's honeypot: people never see it, bots fill it in. -#}
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="calc-name" class="{{ labelClass }}">Your name <span class="text-red-700" aria-hidden="true">*</span></label>
                <input id="calc-name" name="name" type="text" autocomplete="name" required aria-describedby="calc-name-error" class="{{ inputClass }}" />
                <p id="calc-name-error" class="{{ errorClass }}" role="alert"></p>
              </div>
              <div>
                <label for="calc-email" class="{{ labelClass }}">Work email <span class="text-red-700" aria-hidden="true">*</span></label>
                <input id="calc-email" name="email" type="email" autocomplete="email" required aria-describedby="calc-email-error" class="{{ inputClass }}" />
                <p id="calc-email-error" class="{{ errorClass }}" role="alert"></p>
              </div>
            </div>
            <div>
              <label for="calc-org" class="{{ labelClass }}">Organisation <span class="text-gray-600 font-normal">(optional)</span></label>
              <input id="calc-org" name="organisation" type="text" autocomplete="organization" class="{{ inputClass }}" />
            </div>

            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" name="wants_to_talk" value="Yes" class="mt-1 w-4 h-4 accent-forest flex-shrink-0" data-calc-talk-box />
              <span class="text-sm text-gray-700">I'd like to talk to you about training for our managers or HR team.</span>
            </label>
            <div class="hidden" data-calc-message>
              <label for="calc-message" class="{{ labelClass }}">Anything you'd like us to know? <span class="text-gray-600 font-normal">(optional)</span></label>
              <textarea id="calc-message" name="message" rows="3" class="{{ inputClass }} resize-none"></textarea>
            </div>

            <div>
              <label class="flex items-start gap-3 cursor-pointer">
                <input id="calc-consent" type="checkbox" name="consent" value="Yes" required aria-describedby="calc-consent-error" class="mt-1 w-4 h-4 accent-forest flex-shrink-0" data-calc-consent />
                <span class="text-sm text-gray-700">
                  I agree to {{ calcConfig.orgName }} storing my details and the figures above so they can provide my summary and, if I've asked, get in touch about training.
                  See our <a href="/privacy/" class="text-forest font-medium underline underline-offset-2 hover:text-sage" target="_blank">privacy policy</a>.
                  <span class="text-red-700" aria-hidden="true">*</span>
                </span>
              </label>
              <p id="calc-consent-error" class="{{ errorClass }}" role="alert"></p>
            </div>

            <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-forest text-white font-medium px-6 py-3 rounded hover:bg-sage transition-colors disabled:opacity-60" data-calc-submit>
              <i data-lucide="file-text" class="w-4 h-4"></i>
              <span data-calc-submit-label>Get my summary</span>
            </button>
            <p class="hidden text-sm text-red-700" role="alert" data-calc-form-error></p>
          </form>
        </div>

        <div class="hidden" data-calc-unlocked>
          <{{ subTag }} class="font-serif text-forest text-2xl">Your summary is ready</{{ subTag }}>
          <p class="text-gray-600 mt-2" data-calc-thanks>Thank you. Download it below; it reflects the figures currently entered above.</p>
          <div class="flex flex-wrap gap-4 mt-6">
            <button type="button" class="inline-flex items-center gap-2 bg-forest text-white font-medium px-6 py-3 rounded hover:bg-sage transition-colors" data-calc-download>
              <i data-lucide="download" class="w-4 h-4"></i>
              Download summary (PDF)
            </button>
          </div>
          <p class="hidden text-sm text-red-700 mt-3" role="alert" data-calc-download-error></p>
          <p class="text-xs text-gray-600 mt-3">Opens a printable summary. Choose "Save as PDF" in the print window.</p>
        </div>
      </div>

      {% if calc.sourceNote %}
      <p class="text-xs text-gray-600 leading-relaxed">{{ calc.sourceNote | lines }}</p>
      {% endif %}
    </div>

    <!-- ── What to do about it ── -->
    <div class="max-w-2xl mx-auto text-center mt-12">
      {% if calc.ctaText %}
      <p class="text-gray-600 leading-relaxed mb-6">{{ calc.ctaText | lines }}</p>
      {% endif %}
      <div class="flex flex-wrap gap-4 justify-center">
        {%- if calc.ctaButtonLabel %}
        {#- Opens the form above with "talk about training" ticked; without JavaScript it
            falls back to the contact page. -#}
        <a href="{{ links.contact }}" data-calc-talk class="inline-flex items-center gap-2 bg-forest text-white font-medium px-6 py-3 rounded hover:bg-sage transition-colors">
          <i data-lucide="message-circle" class="w-4 h-4"></i>
          {{ calc.ctaButtonLabel }}
        </a>
        {%- endif %}
        <button type="button" data-calc-share
          class="inline-flex items-center gap-2 border border-forest text-forest font-medium px-6 py-3 rounded hover:bg-forest hover:text-white transition-colors">
          <i data-lucide="share-2" class="w-4 h-4"></i>
          <span data-calc-share-label>Share this calculator</span>
        </button>
      </div>
    </div>

  </div>
</section>

<style>
  .calc-range { accent-color: {{ colors.accent }}; }
  .calc-panel[open] .calc-panel-icon { transform: rotate(45deg); }
  .calc-panel-icon { transition: transform 0.2s ease; }
  .calc-panel summary::-webkit-details-marker { display: none; }
  .calc-panel summary:focus-visible { outline: 3px solid {{ colors.accentText }}; outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .calc-panel-icon { transition: none; } }
</style>
<script id="calc-config" type="application/json">{{ calcConfig | dump | replace("<", "\\u003c") | safe }}</script>
<script src="{{ '/js/cost-calculator.js' | versioned }}"></script>
<script src="{{ '/js/cost-calculator-page.js' | versioned }}"></script>
