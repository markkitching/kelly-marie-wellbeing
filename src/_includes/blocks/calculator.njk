{#
  "What is poor mental health costing your business?" — one estimate from one number.

  Shown on the Training & Coaching page and on its own page at /cost-calculator/, the
  address meant for sharing. Both read the same content (src/content/calculator.json),
  so editing the wording in the CMS changes it in both places.

  The maths is staff × a per-employee cost for each of absence, presenteeism and
  turnover. Those three figures are editable; a cleared one falls back to the default
  below rather than quietly counting as zero.

  Expects: bg (section background), calcHeadingTag ("h1" on its own page, else "h2").
#}
{%- set calc = content.calculator or {} -%}
{%- set costs = [
  { key: "presenteeism", label: "Working while unwell", note: "Lower focus and productivity when people come in but are struggling", value: calc.presenteeismCost | float(800) },
  { key: "turnover", label: "Staff leaving", note: "Recruiting, onboarding and lost experience when people leave", value: calc.turnoverCost | float(670) },
  { key: "absence", label: "Sickness absence", note: "Days lost to stress, anxiety, depression and burnout", value: calc.absenceCost | float(230) }
] -%}
{%- set perEmployee = costs[0].value + costs[1].value + costs[2].value -%}
{%- set tag = calcHeadingTag or "h2" -%}
<!-- ══════════════════════════ COST CALCULATOR ══════════════════════════ -->
<section id="calculator" class="{{ bg }} py-20" data-calculator>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center">
      {% if calc.eyebrow %}
      <div class="flex items-center justify-center gap-2 mb-6">
        <span class="w-px h-5 bg-sage"></span>
        <span class="text-sage text-sm font-semibold uppercase tracking-widest">{{ calc.eyebrow }}</span>
        <span class="w-px h-5 bg-sage"></span>
      </div>
      {% endif %}
      <{{ tag }} class="font-serif text-forest {% if tag == 'h1' %}text-4xl lg:text-5xl{% else %}text-3xl{% endif %} leading-tight max-w-3xl mx-auto">
        {{ calc.heading or "What Is Poor Mental Health Costing Your Business?" }}
      </{{ tag }}>
      <div class="divider mt-4 mb-8 mx-auto"></div>
      {% if calc.intro %}
      <p class="text-gray-600 text-lg leading-relaxed max-w-2xl mx-auto mb-12">{{ calc.intro | lines }}</p>
      {% endif %}
    </div>

    <div class="max-w-4xl mx-auto bg-white rounded-lg border border-gray-100 border-t-4 border-t-sage shadow-sm grid md:grid-cols-5">

      <!-- The one question -->
      <div class="md:col-span-2 p-6 sm:p-8 bg-stone/60 md:rounded-bl-lg flex flex-col justify-center">
        <label for="calc-staff" class="block font-medium text-forest mb-3">
          {{ calc.staffLabel or "How many people does your organisation employ?" }}
        </label>
        <div class="flex items-stretch rounded border border-gray-300 bg-white focus-within:border-sage focus-within:ring-2 focus-within:ring-sage/30">
          <span class="flex items-center pl-4 text-sage" aria-hidden="true"><i data-lucide="users" class="w-5 h-5"></i></span>
          <input id="calc-staff" type="number" inputmode="numeric" min="1" max="1000000" step="1" value="50"
            class="w-full px-3 py-3 text-2xl font-semibold text-forest bg-transparent outline-none" data-calc-staff />
        </div>
        <input type="range" min="1" max="500" step="1" value="50" aria-label="Number of employees"
          class="calc-range w-full mt-5" data-calc-range />
        <div class="flex justify-between text-xs text-gray-500 mt-1" aria-hidden="true">
          <span>1</span><span>500+</span>
        </div>
      </div>

      <!-- The answer -->
      <div class="md:col-span-3 p-6 sm:p-8" aria-live="polite">
        <p class="text-gray-600 text-sm">{{ calc.resultLabel or "Poor mental health could be costing your organisation around" }}</p>
        <p class="font-serif text-forest text-4xl sm:text-5xl mt-2">
          <span data-calc-total>&pound;{{ (perEmployee * 50) | round | int }}</span><span class="text-lg text-gray-500 font-sans"> a year</span>
        </p>
        <p class="text-sm text-gray-500 mt-2">
          That's about <span class="font-medium text-forest" data-calc-per>&pound;{{ perEmployee | round | int }}</span> per employee, every year.
        </p>

        <ul class="mt-8 space-y-5">
          {% for cost in costs %}
          <li>
            <div class="flex items-baseline justify-between gap-4">
              <span class="font-medium text-forest">{{ cost.label }}</span>
              <span class="font-semibold text-forest tabular-nums" data-calc-part="{{ cost.value }}">&pound;{{ (cost.value * 50) | round | int }}</span>
            </div>
            <div class="h-2 rounded-full bg-stone mt-2 overflow-hidden">
              <div class="h-full rounded-full bg-sage" style="width: {{ (cost.value / perEmployee * 100) | round(1) if perEmployee else 0 }}%"></div>
            </div>
            <p class="text-xs text-gray-500 mt-1.5">{{ cost.note }}</p>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    {% if calc.sourceNote %}
    <p class="text-xs text-gray-500 leading-relaxed max-w-4xl mx-auto mt-4">{{ calc.sourceNote | lines }}</p>
    {% endif %}

    <!-- What to do about it -->
    {%- if calc.ctaHeading or calc.ctaText or calc.ctaButtonLabel %}
    <div class="max-w-2xl mx-auto text-center mt-14">
      {% if calc.ctaHeading %}
      <h3 class="font-serif text-forest text-2xl mb-3">{{ calc.ctaHeading }}</h3>
      {% endif %}
      {% if calc.ctaText %}
      <p class="text-gray-600 leading-relaxed mb-8">{{ calc.ctaText | lines }}</p>
      {% endif %}
    </div>
    {%- endif %}
    <div class="flex flex-wrap gap-4 justify-center{% if not (calc.ctaHeading or calc.ctaText) %} mt-10{% endif %}">
      {%- if calc.ctaButtonLabel %}
      <a href="{{ calc.ctaButtonHref or links.contact }}" class="inline-flex items-center gap-2 bg-forest text-white font-medium px-6 py-3 rounded hover:bg-sage transition-colors">
        <i data-lucide="message-circle" class="w-4 h-4"></i>
        {{ calc.ctaButtonLabel }}
      </a>
      {%- endif %}
      <button type="button" data-calc-share
        class="inline-flex items-center gap-2 border border-forest text-forest font-medium px-6 py-3 rounded hover:bg-forest hover:text-white transition-colors">
        <i data-lucide="share-2" class="w-4 h-4"></i>
        <span data-calc-share-label>Share this calculator</span>
      </button>
    </div>

  </div>
</section>

<style>
  .calc-range { accent-color: {{ colors.accent }}; }
  [data-calculator] input[type=number]::-webkit-inner-spin-button { opacity: 0.5; }
</style>
<script>
  (function () {
    var root = document.getElementById("calculator");
    var staff = root.querySelector("[data-calc-staff]");
    var range = root.querySelector("[data-calc-range]");
    var parts = root.querySelectorAll("[data-calc-part]");
    var gbp = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP", maximumFractionDigits: 0 });
    var per = 0;
    parts.forEach(function (el) { per += parseFloat(el.dataset.calcPart) || 0; });
    root.querySelector("[data-calc-per]").textContent = gbp.format(per);

    function update(n) {
      n = Math.max(0, Math.floor(n) || 0);
      root.querySelector("[data-calc-total]").textContent = gbp.format(per * n);
      parts.forEach(function (el) { el.textContent = gbp.format((parseFloat(el.dataset.calcPart) || 0) * n); });
    }
    staff.addEventListener("input", function () {
      update(staff.value);
      range.value = Math.min(staff.value, range.max);
    });
    range.addEventListener("input", function () {
      staff.value = range.value;
      update(range.value);
    });
    update(staff.value);

    // Shares the calculator's own page, whose link preview is written for it, even when
    // this copy sits on the Training page.
    var shareBtn = root.querySelector("[data-calc-share]");
    var shareLabel = root.querySelector("[data-calc-share-label]");
    shareBtn.addEventListener("click", function () {
      var url = location.origin + "{{ links.calculator }}";
      var title = {{ (calc.heading or "What is poor mental health costing your business?") | dump | safe }};
      if (navigator.share) {
        navigator.share({ title: title, url: url }).catch(function () {});
        return;
      }
      navigator.clipboard.writeText(url).then(function () {
        shareLabel.textContent = "Link copied";
        setTimeout(function () { shareLabel.textContent = "Share this calculator"; }, 2500);
      }, function () { window.prompt("Copy this link:", url); });
    });
  })();
</script>
