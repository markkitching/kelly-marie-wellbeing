<!DOCTYPE html>
<html lang="en-GB" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if pageTitle %}{{ pageTitle }} | {{ content.header.logoLine1 }} {{ content.header.logoLine2 }}{% else %}{{ content.site.title }}{% endif %}</title>
  <meta name="description" content="{{ pageDescription or content.site.description }}" />

  <!-- Link previews on social media. A page can set pageDescription to be described in
       its own words; the rest use the site-wide description. -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ content.header.logoLine1 }} {{ content.header.logoLine2 }}" />
  <meta property="og:title" content="{% if pageTitle %}{{ pageTitle }}{% else %}{{ content.site.title }}{% endif %}" />
  <meta property="og:description" content="{{ pageDescription or content.site.description }}" />
  <meta property="og:url" content="{{ links.site }}{{ page.url }}" />
  {# The logo card (src/images/share-image.jpg, 1200×630) shown when a link is shared. #}
  <meta property="og:image" content="{{ links.site }}/images/share-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{ content.header.logoLine1 }} {{ content.header.logoLine2 }} logo" />
  <meta name="twitter:card" content="summary_large_image" />
  {%- if noindex %}
  <meta name="robots" content="noindex" />
  {%- endif %}

  <!-- Favicon -->
  <link rel="icon" href="/images/favicon.ico" sizes="any" />

  <!-- Fonts: Playfair Display and Inter (SIL Open Font License), served from this site
       rather than Google so visitors' details aren't sent to a third party. Latin set only;
       see src/fonts/ for the files and licences. -->
  <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/playfair-display-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <style>
    @font-face { font-family: 'Playfair Display'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/playfair-display-latin-400-normal.woff2') format('woff2'); }
    @font-face { font-family: 'Playfair Display'; font-style: italic; font-weight: 400; font-display: swap; src: url('/fonts/playfair-display-latin-400-italic.woff2') format('woff2'); }
    @font-face { font-family: 'Playfair Display'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/playfair-display-latin-600-normal.woff2') format('woff2'); }
    @font-face { font-family: 'Inter'; font-style: normal; font-weight: 300; font-display: swap; src: url('/fonts/inter-latin-300-normal.woff2') format('woff2'); }
    @font-face { font-family: 'Inter'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/inter-latin-400-normal.woff2') format('woff2'); }
    @font-face { font-family: 'Inter'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/inter-latin-500-normal.woff2') format('woff2'); }
    @font-face { font-family: 'Inter'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/inter-latin-600-normal.woff2') format('woff2'); }
  </style>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ['Playfair Display', 'Georgia', 'serif'],
            sans:  ['Inter', 'system-ui', 'sans-serif'],
          },
          colors: {
            forest: '{{ colors.dark }}',
            // Text-safe versions of the accent, worked out in _data/colors.js so every
            // colour scheme meets WCAG AA contrast.
            sage:   '{{ colors.accentText }}',
            'sage-light': '{{ colors.accentOnDark }}',
            mist:   '{{ colors.mutedOnDark }}',
            stone:  '{{ colors.light }}',
            cream:  '{{ colors.cream }}',
          },
        },
      },
    }
  </script>

  <!-- Lucide Icons -->
  {#- A fixed version, served from this site, so an upstream change can't alter or break
      the icons. To upgrade: replace the file, update this path, and check every icon in
      scripts/gen-pages-yml.py's ICONS list still exists in the new version. -#}
  <script src="/js/vendor/lucide-1.55.0.min.js"></script>

  <style>
    html { scroll-padding-top: 72px; }
    .service-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .service-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(28,53,83,0.12); }
    .step-connector { flex: 1; height: 2px; background: {{ colors.accent }}; opacity: 0.4; margin-top: -1.5rem; }
    .photo-placeholder { background: linear-gradient(135deg, {{ colors.accent }}22 0%, {{ colors.dark }}22 100%); }
    #nav-menu { transform-origin: top right; }
    #nav-menu:not(.hidden) { animation: navMenuIn 0.15s ease-out; }
    @keyframes navMenuIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }

    /* Menu handle — three bars that fold into a cross */
    .nav-burger {
      width: 44px; height: 44px; border-radius: 6px;
      display: inline-flex; align-items: center; justify-content: center;
      color: {{ colors.dark }};
      border: 1px solid {{ colors.accent }}33;
      background: transparent;
      transition: background-color 0.2s ease, border-color 0.2s ease;
    }
    .nav-burger:hover { background: {{ colors.accent }}14; border-color: {{ colors.accent }}66; }
    .nav-burger-bars { position: relative; width: 20px; height: 14px; }
    .nav-burger-bars span {
      position: absolute; left: 0; height: 2px; border-radius: 2px;
      background: currentColor;
      transition: width 0.28s ease, opacity 0.18s ease,
                  transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .nav-burger-bars span:nth-child(1) { top: 0;    width: 20px; }
    .nav-burger-bars span:nth-child(2) { top: 6px;  width: 12px; }
    .nav-burger-bars span:nth-child(3) { top: 12px; width: 20px; }
    .nav-burger:hover .nav-burger-bars span:nth-child(2) { width: 20px; }

    .nav-burger[aria-expanded="true"] .nav-burger-bars span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .nav-burger[aria-expanded="true"] .nav-burger-bars span:nth-child(2) { opacity: 0; transform: translateX(-8px); }
    .nav-burger[aria-expanded="true"] .nav-burger-bars span:nth-child(3) { width: 20px; transform: translateY(-6px) rotate(-45deg); }

    @media (prefers-reduced-motion: reduce) {
      #nav-menu:not(.hidden) { animation: none; }
      .nav-burger-bars span { transition: none; }
    }
    /* Podcast episode — a still that becomes the player on click, so nothing is
       requested from YouTube until the visitor asks for it */
    .yt-facade {
      position: relative; display: block; width: 100%; aspect-ratio: 16 / 9;
      padding: 0; border: 0; cursor: pointer; background: #000; overflow: hidden;
    }
    .yt-facade img {
      display: block; width: 100%; height: 100%; object-fit: cover;
      transition: opacity 0.2s ease, transform 0.35s ease;
    }
    .yt-facade:hover img { opacity: 0.82; transform: scale(1.03); }
    .yt-play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
    .yt-play svg {
      box-sizing: border-box; width: 54px; height: 54px; padding: 13px;
      color: #fff; background: {{ colors.dark }}d9; border-radius: 999px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
      transition: background-color 0.2s ease, transform 0.2s ease;
    }
    .yt-facade:hover .yt-play svg { background: {{ colors.dark }}; transform: scale(1.07); }
    .yt-facade:focus-visible { outline: 3px solid {{ colors.accent }}; outline-offset: -3px; }
    .yt-frame { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; }

    /* Audio-only episode — the show artwork where the video still would be. It is
       square, so it is cropped from the centre, where the title sits. */
    .episode-art {
      display: block; aspect-ratio: 16 / 9; overflow: hidden;
      background: {{ colors.light }};
    }
    .episode-art img {
      width: 100%; height: 100%; object-fit: cover; object-position: center;
      transition: transform 0.35s ease, opacity 0.2s ease;
    }
    .episode-art:hover img { transform: scale(1.03); opacity: 0.9; }
    .episode-art:focus-visible { outline: 3px solid {{ colors.accent }}; outline-offset: -3px; }
    @media (prefers-reduced-motion: reduce) {
      .episode-art img { transition: none; }
      .episode-art:hover img { transform: none; }
    }

    .episode-media {
      aspect-ratio: 16 / 9; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 8px;
      font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    }
    .episode-audio {
      background: linear-gradient(135deg, {{ colors.accent }}22 0%, {{ colors.dark }}22 100%);
      color: {{ colors.dark }}; opacity: 0.75;
    }
    .episode-pending {
      background: {{ colors.light }}; border-bottom: 1px dashed {{ colors.accent }}4d;
      color: {{ colors.accent }}; opacity: 0.6;
    }

    @media (prefers-reduced-motion: reduce) {
      .yt-facade img, .yt-play svg { transition: none; }
      .yt-facade:hover img { transform: none; }
    }

    /* FAQ accordion — the plus turns into a cross when open */
    .faq summary::-webkit-details-marker { display: none; }
    .faq summary::marker { content: ""; }
    .faq summary:hover span { color: {{ colors.accent }}; }
    .faq-icon { transition: transform 0.2s ease; }
    .faq[open] .faq-icon { transform: rotate(45deg); }
    @media (prefers-reduced-motion: reduce) { .faq-icon { transition: none; } }

    .divider { width: 48px; height: 3px; background: {{ colors.accent }}; }
    /* A clear focus ring for keyboard users, everywhere. Inputs keep their own ring. */
    :focus-visible { outline: 3px solid {{ colors.accentText }}; outline-offset: 2px; }
    footer :focus-visible, .bg-forest :focus-visible { outline-color: #ffffff; }
  </style>
</head>

<body class="font-sans bg-white text-gray-800 antialiased">

  <!-- Lets keyboard and screen-reader users jump past the menu. Hidden until focused. -->
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:bg-white focus:text-forest focus:font-medium focus:px-4 focus:py-2 focus:rounded focus:shadow">Skip to content</a>

  <!-- ═══════════════════════════════════════════════
       STICKY NAVIGATION
  ════════════════════════════════════════════════ -->
  <header class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative flex items-center justify-between h-[72px]">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group">
          {% if content.header.logoImage %}
          <img src="{{ content.header.logoImage }}" alt="" width="40" height="40" class="w-10 h-10 object-contain flex-shrink-0" />
          {% else %}
          <span class="w-8 h-8 rounded-full bg-forest flex items-center justify-center flex-shrink-0">
            <i data-lucide="{{ content.header.logoIcon }}" class="text-sage-light w-4 h-4"></i>
          </span>
          {% endif %}
          <span class="font-serif text-forest text-lg font-semibold leading-tight">
            {{ content.header.logoLine1 }}<br><span class="font-normal text-sm text-sage">{{ content.header.logoLine2 }}</span>
          </span>
        </a>

        <!-- Right-hand controls -->
        <div class="flex items-center gap-3">
          {%- if content.header.ctaLabel %}
          <a href="{{ content.header.ctaHref or links.contact }}" class="hidden sm:inline-flex items-center gap-1.5 bg-forest text-white text-sm font-medium px-5 py-2 rounded hover:bg-sage transition-colors whitespace-nowrap">
            <i data-lucide="{{ content.header.ctaIcon or "calendar" }}" class="w-3.5 h-3.5"></i>
            {{ content.header.ctaLabel }}
          </a>
          {%- endif %}

          <button id="nav-toggle" class="nav-burger"
            aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu" aria-haspopup="true">
            <span class="nav-burger-bars" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
          </button>
        </div>

        <!-- Menu panel — one flat list, same behaviour at every width -->
        <div id="nav-menu"
          class="hidden absolute right-0 top-full w-64 max-w-[calc(100vw-2rem)] bg-white border border-gray-200 rounded-b rounded-tl shadow-lg py-2">
          {% for link in mainNav %}
          <a href="{{ link.href }}" class="block px-4 py-2.5 text-sm text-gray-700 hover:text-forest hover:bg-stone transition-colors nav-link">{{ link.label }}</a>
          {% endfor %}

          {%- if content.header.ctaLabel %}
          <div class="sm:hidden px-3 pt-3 pb-1 mt-1 border-t border-gray-100">
            <a href="{{ content.header.ctaHref or links.contact }}" class="flex w-full items-center justify-center gap-1.5 bg-forest text-white text-sm font-medium px-3 py-2.5 rounded nav-link">
              <i data-lucide="{{ content.header.ctaIcon or "calendar" }}" class="w-3.5 h-3.5 flex-shrink-0"></i>
              {{ content.header.ctaLabel }}
            </a>
          </div>
          {%- endif %}
        </div>
      </div>
    </nav>
  </header>

  <main id="main" tabindex="-1" class="focus:outline-none">
