---
permalink: "/shop/"
pageTitle: "Shop"
eleventyComputed:
  # Kept out of search engines until "Published" is switched on in the CMS.
  noindex: "{{ '' if shopPage.published else 'yes' }}"
  # | safe so the text is escaped once, by site-header, not twice.
  pageDescription: "{{ shopPage.intro | safe }}"
---
{#- The Shop page: printed mental health sheets, ordered by enquiry. Content comes from
    src/content/shop.json ("Page: Shop" in the CMS) via _data/shopPage.js. No basket or
    payment code: the single order button's text and link are one field each.
    Pack prices and the pricing wording are fields in Page: Shop too.
    Sections alternate light backgrounds like the site's other pages, and every two-column
    row stacks in reading order on a phone. -#}
{%- set shop = shopPage -%}
{% include "site-header.njk" %}

{#- An image, or a placeholder carrying its description until the file is uploaded. -#}
{%- macro shopImage(image) -%}
{% if image.src %}
<img src="{{ image.src }}" alt="{{ image.alt }}" loading="lazy" class="w-full h-auto rounded-lg border border-gray-100" />
{% else %}
<div class="aspect-[4/3] rounded-lg photo-placeholder flex flex-col items-center justify-center gap-3 text-center p-8" role="img" aria-label="{{ image.alt }}">
  <i data-lucide="image" class="w-10 h-10 text-sage" aria-hidden="true"></i>
  <span class="text-sm text-gray-600 max-w-xs" aria-hidden="true">Image to come: {{ image.alt }}</span>
</div>
{% endif %}
{%- endmacro -%}

<!-- ══════════════════════════ HEADING BAND ══════════════════════════ -->
<section class="bg-stone py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    {% if shop.eyebrow %}
    <div class="flex items-center justify-center gap-2 mb-6">
      <span class="w-px h-5 bg-sage"></span>
      <span class="text-sage text-sm font-semibold uppercase tracking-widest">{{ shop.eyebrow }}</span>
      <span class="w-px h-5 bg-sage"></span>
    </div>
    {% endif %}
    <h1 class="font-serif text-forest text-4xl lg:text-5xl leading-tight">{{ shop.heading or "Shop" }}</h1>
    <div class="divider mt-6 mb-8 mx-auto"></div>
    {% if shop.intro %}
    <p class="text-gray-600 text-lg leading-relaxed max-w-2xl mx-auto">{{ shop.intro | lines }}</p>
    {% endif %}
  </div>
</section>

<!-- ══════════════════════════ THE RANGE ══════════════════════════ -->
<section class="bg-white py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-12 items-center">
    <div>{{ shopImage(shop.images[0]) }}</div>
    <div>
      {% if shop.rangeTitle %}
      <h2 class="font-serif text-forest text-3xl">{{ shop.rangeTitle }}</h2>
      <div class="divider mt-4 mb-8"></div>
      {% endif %}
      <ul class="space-y-4">
        {% for item in shop.rangeItems %}
        <li class="flex items-start gap-3">
          <span class="w-5 h-5 rounded-full bg-sage/15 flex items-center justify-center flex-shrink-0 mt-0.5">
            <i data-lucide="check" class="w-3 h-3 text-forest"></i>
          </span>
          <span class="text-gray-600 leading-relaxed">{{ item.text }}</span>
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

<!-- ══════════════════════════ PRICING ══════════════════════════ -->
{#- From the pricing fields in Page: Shop, via _data/shopPage.js (which fills in the
    {sets}/{sheets}/{perSet} wording and checks the sums). Cards sit side by side from lg
    up and stack below that, with the highlighted pack first. Each button goes to the
    contact page with the pack named in the link (?enquiry=), ready for the form to read,
    or, once a pack has a Stripe link and the business address is set, to Stripe. -#}
{%- set pricing = shop.pricing -%}
{%- if pricing.packs | length %}
<section class="bg-stone py-20" id="pricing">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    {% if pricing.heading %}
    <h2 class="font-serif text-forest text-3xl text-center">{{ pricing.heading }}</h2>
    <div class="divider mt-4 mb-12 mx-auto"></div>
    {% endif %}
    {%- set packCount = pricing.packs | length %}
    <div class="grid gap-8 max-w-sm mx-auto {{ 'lg:grid-cols-3 lg:max-w-none' if packCount >= 3 else ('lg:grid-cols-2 lg:max-w-3xl' if packCount == 2) }}">
      {% for pack in pricing.packs %}
      <div class="relative bg-white rounded-lg p-6 sm:p-8 flex flex-col text-center {{ 'border-2 border-forest shadow-md order-first lg:order-none' if pack.highlight else 'border border-gray-200' }}">
        {% if pack.highlight and pricing.bestValueLabel %}
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap bg-forest text-white text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full">{{ pricing.bestValueLabel }}</span>
        {% endif %}
        <h3 class="font-serif text-forest text-2xl">{{ pack.name }}</h3>
        {% if pack.setsText %}<p class="mt-3 font-medium text-forest">{{ pack.setsText }}</p>{% endif %}
        {% if pack.detailText %}<p class="text-gray-600 text-sm">{{ pack.detailText }}</p>{% endif %}
        <p class="mt-6 font-serif text-forest text-4xl">{{ pack.price }}{% if pricing.vatLabel %} <span class="font-sans text-base text-gray-600">{{ pricing.vatLabel }}</span>{% endif %}</p>
        {% if pack.perSetText %}<p class="mt-1 text-gray-600 text-sm">{{ pricing.perSetVat(pack.perSetText) }}</p>{% endif %}
        {% if pack.extra %}
        <p class="mt-4 text-forest text-sm font-medium">{{ pack.extra }}</p>
        {% endif %}
        <div class="mt-auto pt-6">
          {#- On sale: the main button goes to Stripe, with an optional small enquiry link
              (e.g. "Or pay by invoice") underneath. Otherwise the main button is the enquiry. -#}
          {%- set enquiryHref = links.contact + "?enquiry=" + (pack.enquiry | urlencode) %}
          {%- set mainClass = 'bg-forest text-white hover:bg-sage' if pack.highlight else 'border border-forest text-forest hover:bg-forest hover:text-white' %}
          {% if pack.onSale %}
          <a href="{{ pack.buyLink }}" aria-label="{{ pricing.buyLabel }}: {{ pack.name }} pack" class="w-full inline-flex items-center justify-center gap-2 font-medium px-6 py-3 rounded transition-colors {{ mainClass }}">
            <i data-lucide="shopping-bag" class="w-4 h-4"></i>
            {{ pricing.buyLabel }}
          </a>
          {% if pricing.invoiceLabel %}
          <a href="{{ enquiryHref }}" aria-label="{{ pricing.invoiceLabel }}: {{ pack.name }} pack" class="mt-3 inline-block text-sm text-forest underline underline-offset-2 hover:text-sage">{{ pricing.invoiceLabel }}</a>
          {% endif %}
          {% else %}
          <a href="{{ enquiryHref }}" class="w-full inline-flex items-center justify-center gap-2 font-medium px-6 py-3 rounded transition-colors {{ mainClass }}">
            <i data-lucide="mail" class="w-4 h-4"></i>
            {{ pack.button }}
          </a>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% if pricing.footnote %}
    <p class="mt-10 text-center text-gray-600 max-w-2xl mx-auto">{{ pricing.footnote }}</p>
    {% endif %}
    {% if shop.selling %}
    <p class="mt-3 text-center text-gray-500 text-xs">Card payments are taken securely by Stripe. By buying you agree to our <a href="/terms/" class="underline underline-offset-2 hover:text-sage">Terms of sale</a>.</p>
    {% endif %}
  </div>
</section>
{%- endif %}

<!-- ══════════════════════════ ORDERING ══════════════════════════ -->
<section class="bg-white py-20" id="order">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-12 items-center">
    <div>{{ shopImage(shop.images[1]) }}</div>
    <div class="bg-white rounded-lg border border-gray-200 border-t-4 border-t-forest p-6 sm:p-8">
      {% if shop.orderHeading %}
      <h2 class="font-serif text-forest text-2xl sm:text-3xl">{{ shop.orderHeading }}</h2>
      {% endif %}
      {% if shop.orderText %}
      <p class="text-gray-600 leading-relaxed mt-3">{{ shop.orderText | lines }}</p>
      {% endif %}
      {% if shop.buttonLabel %}
      <a href="{{ shop.buttonLink }}" class="mt-6 inline-flex items-center gap-2 bg-forest text-white font-medium px-6 py-3 rounded hover:bg-sage transition-colors">
        <i data-lucide="mail" class="w-4 h-4"></i>
        {{ shop.buttonLabel }}
      </a>
      {% endif %}
    </div>
  </div>
</section>

<!-- ══════════════════════════ BRANDED VERSION ══════════════════════════ -->
{%- if shop.brandedHeading or shop.brandedText or shop.images[2].src or shop.images[2].alt %}
<section class="bg-stone py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-12 items-center">
    <div>
      {% if shop.brandedHeading %}
      <h2 class="font-serif text-forest text-3xl">{{ shop.brandedHeading }}</h2>
      <div class="divider mt-4 mb-6"></div>
      {% endif %}
      {% if shop.brandedText %}
      <p class="text-gray-600 text-lg leading-relaxed">{{ shop.brandedText | lines }}</p>
      {% endif %}
    </div>
    <div>{{ shopImage(shop.images[2]) }}</div>
  </div>
</section>
{%- endif %}

<!-- ══════════════════════════ QUESTIONS ══════════════════════════ -->
{#- Hidden unless "Show questions section" is ticked in Page: Shop; the questions
    themselves stay in the CMS either way. -#}
{%- if shop.showFaqs and shop.faqs | length %}
<section class="bg-white py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-serif text-forest text-3xl text-center">{{ shop.faqsTitle or "Questions" }}</h2>
    <div class="divider mt-4 mb-12 mx-auto"></div>
    <div class="max-w-3xl mx-auto divide-y divide-gray-200 border-t border-b border-gray-200">
      {% for faq in shop.faqs %}
      <details class="faq group">
        <summary class="flex items-center justify-between gap-4 cursor-pointer py-5 list-none">
          <span class="font-medium text-forest">{{ faq.question }}</span>
          <i data-lucide="plus" class="faq-icon w-4 h-4 text-sage flex-shrink-0"></i>
        </summary>
        {% if faq.answer or faq.linkLabel %}
        <div class="text-gray-600 text-sm leading-relaxed pb-5 pr-8">
          {{ faq.answer | lines }}
          {% if faq.linkLabel and faq.linkHref %}
          <a href="{{ faq.linkHref }}" class="text-forest font-medium underline underline-offset-2 hover:text-sage">{{ faq.linkLabel }}</a>
          {% endif %}
        </div>
        {% endif %}
      </details>
      {% endfor %}
    </div>
  </div>
</section>
{%- endif %}

{% include "site-footer.njk" %}
